# PSV — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o .env real no git

# Banco de dados
# Desenvolvimento: SQLite local (não precisa instalar nada)
DATABASE_URL=sqlite:///./psv_dev.db
# Produção (PostgreSQL no Supabase ou Railway):
# DATABASE_URL=postgresql://user:password@host:5432/psv

# JWT — gere uma chave forte em produção:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_isso_antes_de_subir_para_producao

# Sessão de 8 horas (em minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Debug — ativa Swagger /docs e logs SQL
DEBUG=true

# CORS — origens permitidas separadas por vírgula
# Desenvolvimento: portas do Vite e CRA
# Produção: seu domínio real
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
