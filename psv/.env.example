# PSV backend environment variables
# Copy this file to .env in development and fill real values.
# Never commit the real .env file.

# Database
# Development: local SQLite, no external database required.
DATABASE_URL=sqlite:///./psv_dev.db
# Production: Supabase PostgreSQL connection string.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# JWT secret. Generate a strong value in production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_isso_antes_de_subir_para_producao

# Session duration in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Contas com acesso ao modo administrativo, separadas por virgula.
ADMIN_EMAILS=luizhenrique.asf@gmail.com

# Development: true enables /docs and SQL logs.
# Production: false disables public docs.
DEBUG=true

# CORS allowed origins.
# Accepted formats:
# ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
#
# Development:
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
#
# Production example:
# ALLOWED_ORIGINS=["https://psv-frontend.vercel.app"]
