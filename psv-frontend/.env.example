# PSV frontend environment variables
# Copy this file to .env.local for local overrides.

# Development:
# Leave empty to use the Vite proxy in vite.config.js.
VITE_API_URL=

# Production on Vercel:
# Set this to the public Railway backend URL, without a trailing slash.
# Example:
# VITE_API_URL=https://psv-api.up.railway.app
